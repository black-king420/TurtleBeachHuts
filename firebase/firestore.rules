rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Guests (anonymous) are not members
    function isMember() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }

    // Admin = this email, OR a user ID that has a document in /admins/{uid}
    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email.lower() in ['ali4@gmail.com'])
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }

    match /admins/{adminUid} {
      allow read: if signedIn() && request.auth.uid == adminUid;
      allow write: if false;
    }

    // used by Admin -> Settings -> Run permissions check
    match /diagnostics/{diagId} {
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email','checkedAt']);
      allow read, delete: if isAdmin();
    }

    // Bookings: members only; each member reads only their own; admins read all
    match /bookings/{bookingId} {
      allow create: if isMember()
        && request.resource.data.keys().hasOnly([
            'name','phone','whatsapp','email','date','time','adults','children',
            'package','request','coupon','status','createdAt','uid','userEmail','userName'])
        && request.resource.data.keys().hasAll(['name','phone','package','status','createdAt','uid'])
        && request.resource.data.uid == request.auth.uid
        && isStr(request.resource.data.name, 1, 120)
        && isStr(request.resource.data.phone, 3, 40)
        && isStr(request.resource.data.package, 1, 100)
        && optStr(request.resource.data, 'date', 20)
        && optStr(request.resource.data, 'whatsapp', 40)
        && optStr(request.resource.data, 'email', 254)
        && optStr(request.resource.data, 'time', 40)
        && optStr(request.resource.data, 'request', 1500)
        && optStr(request.resource.data, 'coupon', 40)
        && optStr(request.resource.data, 'userEmail', 254)
        && optStr(request.resource.data, 'userName', 120)
        && request.resource.data.status == 'Pending'
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Contact messages: anyone can send, only admins can read
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','phone','subject','message','read','createdAt'])
        && request.resource.data.keys().hasAll(['name','email','message','read','createdAt'])
        && isStr(request.resource.data.name, 1, 120)
        && isStr(request.resource.data.email, 3, 254)
        && isStr(request.resource.data.message, 1, 3000)
        && optStr(request.resource.data, 'phone', 40)
        && optStr(request.resource.data, 'subject', 200)
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /newsletter/{entryId} {
      allow create: if request.resource.data.keys().hasOnly(['email','createdAt'])
        && isStr(request.resource.data.email, 5, 254)
        && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Packages & prices: public read, admin write
    match /catalog/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().size() <= 14
        && (itemId == '_settings'
            ? (request.resource.data.fromPrice is number && request.resource.data.fromPrice >= 0)
            : (isStr(request.resource.data.name, 1, 100)
               && (request.resource.data.price == null
                   || (request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.price <= 100000000))
               && isStr(request.resource.data.img, 1, 900000)));
      allow delete: if isAdmin();
    }

    // Huts: public read, admin write
    match /huts/{hutId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['id','name','tag','desc','capacity','rooms','washrooms','price','amenities','images','visible','order'])
        && isStr(request.resource.data.name, 1, 100)
        && optStr(request.resource.data, 'tag', 40)
        && optStr(request.resource.data, 'desc', 1500)
        && optStr(request.resource.data, 'amenities', 600)
        && (request.resource.data.price == null
            || (request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.price <= 100000000))
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 6;
      allow delete: if isAdmin();
    }

    // Gallery: public read, admin write
    match /gallery/{picId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['id','img','cat','caption','order'])
        && isStr(request.resource.data.img, 1, 900000)
        && request.resource.data.cat in ['drone','sunset','events','night','palms']
        && optStr(request.resource.data, 'caption', 120);
      allow delete: if isAdmin();
    }

    // User profiles: each user manages only their own and can never give themselves a role
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','phone','role','provider','createdAt','updatedAt'])
        && request.resource.data.role == 'customer';
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','phone','role','provider','createdAt','updatedAt'])
        && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // Everything else is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}